# ── Server ────────────────────────────────────────────────────────────────
# Copy this file to server/.env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (see README "MongoDB Atlas Setup")
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-financial-analyst

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# AI provider. Supported: "gemini" | "anthropic" | "none"
# "none" disables live AI calls and falls back to a deterministic,
# template-based explanation so the app still works with no key.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

PORT=5000
NODE_ENV=development

# Uploads
MAX_UPLOAD_SIZE_MB=15
